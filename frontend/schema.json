    "host",
    "equipment",
    "goal"
  ],
  "dataSchema": {
    "$defs": {
      "DimensionValue": {
        "additionalProperties": false,
        "description": "尺寸类字段，如 宽×深×高、女主播身高/男主播身高。",
        "properties": {
          "type": {
            "const": "dimension",
            "default": "dimension",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Value",
            "type": "object"
          }
        },
        "title": "DimensionValue",
        "type": "object"
      },
      "ImageValue": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "image",
            "default": "image",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "items": {
              "type": "string"
            },
            "title": "Value",
            "type": "array"
          }
        },
        "title": "ImageValue",
        "type": "object"
      },
      "MultiChoiceValue": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "choice-multi",
            "default": "choice-multi",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "items": {
              "type": "string"
            },
            "title": "Value",
            "type": "array"
          }
        },
        "title": "MultiChoiceValue",
        "type": "object"
      },
      "SectionState": {
        "additionalProperties": false,
        "description": "单个章节的运行时状态。",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "status": {
            "default": "pending",
            "enum": [
              "pending",
              "active",
              "complete",
              "skipped"
            ],
            "title": "Status",
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "discriminator": {
                "mapping": {
                  "choice-multi": "#/$defs/MultiChoiceValue",
                  "choice-single": "#/$defs/SingleChoiceValue",
                  "dimension": "#/$defs/DimensionValue",
                  "image": "#/$defs/ImageValue",
                  "table": "#/$defs/TableValue",
                  "text": "#/$defs/TextValue"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextValue"
                },
                {
                  "$ref": "#/$defs/SingleChoiceValue"
                },
                {
                  "$ref": "#/$defs/MultiChoiceValue"
                },
                {
                  "$ref": "#/$defs/DimensionValue"
                },
                {
                  "$ref": "#/$defs/ImageValue"
                },
                {
                  "$ref": "#/$defs/TableValue"
                }
              ]
            },
            "title": "Fields",
            "type": "object"
          }
        },
        "required": [
          "id"
        ],
        "title": "SectionState",
        "type": "object"
      },
      "SingleChoiceValue": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "choice-single",
            "default": "choice-single",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Value"
          }
        },
        "title": "SingleChoiceValue",
        "type": "object"
      },
      "TableValue": {
        "additionalProperties": false,
        "description": "设备明细表，每行是 {列id: 值}。",
        "properties": {
          "type": {
            "const": "table",
            "default": "table",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Value",
            "type": "array"
          }
        },
        "title": "TableValue",
        "type": "object"
      },
      "TextValue": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "text",
            "default": "text",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "default": "",
            "title": "Value",
            "type": "string"
          }
        },
        "title": "TextValue",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "完整表单状态，跨会话持久化的对象。\n\n序列化统一用 camelCase（与前端 TS 一致）：\ncurrent_section_id → currentSectionId",
    "properties": {
      "mode": {
        "default": "full",
        "enum": [
          "full",
          "quick"
        ],
        "title": "Mode",
        "type": "string"
      },
      "requiredFieldIds": {
        "items": {
          "type": "string"
        },
        "title": "Requiredfieldids",
        "type": "array"
      },
      "sections": {
        "additionalProperties": {
          "$ref": "#/$defs/SectionState"
        },
        "title": "Sections",
        "type": "object"
      },
      "currentSectionId": {
        "default": "",
        "title": "Currentsectionid",
        "type": "string"
      },
      "currentFieldId": {
        "default": "",
        "title": "Currentfieldid",
        "type": "string"
      },
      "skippedFieldIds": {
        "items": {
          "type": "string"
        },
        "title": "Skippedfieldids",
        "type": "array"
      },
      "roomImageInvited": {
        "default": false,
        "title": "Roomimageinvited",
        "type": "boolean"
      },
      "referenceImageInvited": {
        "default": false,
        "title": "Referenceimageinvited",
        "type": "boolean"
      },
      "equipmentImageInvited": {
        "default": false,
        "title": "Equipmentimageinvited",
        "type": "boolean"
      },
      "imageInvitedFieldIds": {
        "items": {
          "type": "string"
        },
        "title": "Imageinvitedfieldids",
        "type": "array"
      },
      "completed": {
        "default": false,
        "title": "Completed",
        "type": "boolean"
      }
    },
    "title": "StudioFormState",
    "type": "object"
  }
}