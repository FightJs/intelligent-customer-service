# LLM 配置（填写支持图片输入的 Anthropic 兼容模型）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=your-anthropic-compatible-base-url
LLM_MODEL=your-multimodal-model-id

# Auth 配置
JWT_SECRET=change-this-to-a-random-long-string-in-production
TOKEN_EXPIRE_MINUTES=10080

# 初始管理员账号（首次启动自动创建；改 env 后需删 users 表对应行才会重建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 聊天额度（同时按用户和客户端 IP 统计；0 不是关闭开关）
CHAT_RATE_LIMIT_PER_MINUTE=12
CHAT_DAILY_MESSAGE_LIMIT=200
CHAT_DAILY_IMAGE_LIMIT=30
