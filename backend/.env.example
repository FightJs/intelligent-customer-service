# LLM 配置（填写支持图片输入的 Anthropic 兼容模型）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=your-anthropic-compatible-base-url
LLM_MODEL=your-multimodal-model-id

# Auth 配置
JWT_SECRET=change-this-to-a-random-long-string-in-production
TOKEN_EXPIRE_MINUTES=10080

# 初始管理员账号（首次启动自动创建；改 env 后需删 users 表对应行才会重建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 聊天额度（同时按用户和客户端 IP 统计；0 不是关闭开关）
CHAT_RATE_LIMIT_PER_MINUTE=12
CHAT_DAILY_MESSAGE_LIMIT=200
CHAT_DAILY_IMAGE_LIMIT=30

# F1 知识库（Qdrant）
# 开发：QDRANT_URI=memory://  EMBEDDING_PROVIDER=mock
# 嵌入式：QDRANT_URI=./data/qdrant
# 服务端：docker compose -f ../deploy/qdrant.yml up -d
# EMBEDDING_PROVIDER: dashscope | openrouter | local_bge | mock
# RERANK_PROVIDER: local | dashscope | identity
QDRANT_URI=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
# OpenRouter（OpenAI 兼容 embeddings；EMBEDDING_PROVIDER=openrouter 时生效）
# 模型示例：openai/text-embedding-3-small（dimensions 对齐 1024）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RERANK_PROVIDER=local
RERANK_MODEL=bge-reranker-v2-m3
KNOWLEDGE_FUSION=weighted
KNOWLEDGE_DENSE_WEIGHT=0.6
KNOWLEDGE_SPARSE_WEIGHT=0.4

# LangSmith（后端当前未接 tracing，仅预留）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=intelligent-customer-service

# 智能交付管线（F3 生图 / F4 预览视频）
# MEDIA_PROVIDER: openrouter | dashscope
MEDIA_PROVIDER=dashscope
IMAGE_MODEL=wan2.7-image
IMAGE_FALLBACK_MODEL=qwen-image
IMAGE_TIMEOUT_SEC=180
VIDEO_MODEL=wan2.7-i2v
VIDEO_FALLBACK_MODEL=kling-v3-video
VIDEO_TIER=standard
VIDEO_FLASH_MODEL=wan2.6-i2v-flash
VIDEO_TIMEOUT_SEC=300
ARTIFACT_ROOT=./data/artifacts
